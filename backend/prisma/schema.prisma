datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Tenant Store Entity (Multi-Tenant Showroom Profile)
model Tenant {
  id                  String   @id @default(uuid())
  name                String
  tradeName           String
  branch              String   @default("Main Showroom")
  city                String   @default("Mumbai")
  address             String   @db.Text
  phone               String
  email               String
  gstin               String
  pan                 String
  bisLicenseNo        String
  moneyLendingLicense String?
  bankName            String?
  accountNumber       String?
  ifscCode            String?
  upiVpa              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
  customers           Customer[]
  products            Product[]
  invoices            Invoice[]
  girviLoans          GirviLoan[]
  schemes             SavingsScheme[]
  karigars            KarigarAccount[]
  udhaarAccounts      UdhaarAccount[]
  rateHistory         BullionRateHistory[]

  @@map("tenants")
}

// 2. Staff User Entity & RBAC
model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CASHIER") // ADMIN, CASHIER, GIRVI_OFFICER, WORKSHOP_SUPERVISOR
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@map("users")
}

// 3. Customer Profile & KYC
model Customer {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  city           String?
  address        String?  @db.Text
  pan            String?
  aadhaarLast4   String?
  loyaltyTier    String   @default("SILVER") // SILVER, GOLD, PLATINUM
  loyaltyPoints  Int      @default(0)
  creditLimit    Decimal  @default(50000.00) @db.Decimal(12, 2)
  isCreditBlocked Boolean @default(false)
  createdAt      DateTime @default(now())

  invoices       Invoice[]
  girviLoans     GirviLoan[]
  schemes        SchemeMember[]
  udhaarAccounts UdhaarAccount[]

  @@index([tenantId])
  @@index([phone])
  @@map("customers")
}

// 4. Inventory Product (Gold, Diamond 4Cs, RFID & HUID)
model Product {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barcode           String   @unique
  rfidTag           String?  @unique
  name              String
  category          String   // Rings, Chains, Necklaces, Bangles, Silver
  metal             String   @default("Gold") // Gold, Silver, Platinum
  purity            String   // 24K, 22K, 18K, 14K, 925
  purityPercent     Decimal  @db.Decimal(5, 2)
  huid              String   // 6-digit BIS Laser Hallmark Code
  grossWeight       Decimal  @db.Decimal(10, 4)
  stoneWeight       Decimal  @default(0.0000) @db.Decimal(10, 4)
  netWeight         Decimal  @db.Decimal(10, 4)
  wastagePercent    Decimal  @default(0.00) @db.Decimal(5, 2)
  makingChargeType  String   @default("PER_GRAM") // PER_GRAM, PERCENTAGE, FLAT
  makingChargeRate  Decimal  @db.Decimal(10, 2)
  hallmarkCharge    Decimal  @default(45.00) @db.Decimal(10, 2)
  trayNo            String?
  imageUrl          String?  @db.Text
  status            String   @default("IN_STOCK") // IN_STOCK, SOLD, ON_APPROVAL, MELTING
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoiceItems      InvoiceItem[]

  @@index([tenantId])
  @@index([category])
  @@index([huid])
  @@map("products")
}

// 5. Invoices & Sales Orders
model Invoice {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNo       String   @unique
  invoiceType     String   @default("TAX_INVOICE") // TAX_INVOICE, ESTIMATE
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal        Decimal  @db.Decimal(12, 2)
  discount        Decimal  @default(0.00) @db.Decimal(12, 2)
  exchangeCredit  Decimal  @default(0.00) @db.Decimal(12, 2)
  taxableAmount   Decimal  @db.Decimal(12, 2)
  cgst            Decimal  @default(0.00) @db.Decimal(12, 2)
  sgst            Decimal  @default(0.00) @db.Decimal(12, 2)
  grandTotal      Decimal  @db.Decimal(12, 2)
  paymentMode     String   @default("CASH") // CASH, UPI, CARD, SPLIT, UDHAAR
  paymentDetails  Json?
  cashierName     String?
  createdAt       DateTime @default(now())

  items           InvoiceItem[]
  oldGoldExchange OldGoldExchange?

  @@index([tenantId])
  @@index([invoiceNo])
  @@map("invoices")
}

// 6. Invoice Line Items
model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemName      String
  huid          String?
  grossWeight   Decimal  @db.Decimal(10, 4)
  netWeight     Decimal  @db.Decimal(10, 4)
  purity        String
  goldRate      Decimal  @db.Decimal(10, 2)
  makingCharges Decimal  @db.Decimal(10, 2)
  stoneCharges  Decimal  @default(0.00) @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

// 7. Old Gold Scrap Exchange
model OldGoldExchange {
  id             String   @id @default(uuid())
  invoiceId      String   @unique
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  grossWeight    Decimal  @db.Decimal(10, 4)
  lessWeight     Decimal  @db.Decimal(10, 4)
  netWeight      Decimal  @db.Decimal(10, 4)
  purityPercent  Decimal  @db.Decimal(5, 2)
  fineGoldWeight Decimal  @db.Decimal(10, 4)
  scrapRate      Decimal  @db.Decimal(10, 2)
  totalCredit    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  @@map("old_gold_exchanges")
}

// 8. Girvi / Gold Loan Accounts
model GirviLoan {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanNo               String   @unique
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  principalAmount      Decimal  @db.Decimal(12, 2)
  monthlyInterestRate  Decimal  @db.Decimal(5, 2)
  interestModel        String   @default("MONTHLY_SIMPLE") // SIMPLE, COMPOUND, 15_DAY_SLAB
  tenureMonths         Int      @default(11)
  accruedInterest      Decimal  @default(0.00) @db.Decimal(12, 2)
  totalPaidInterest    Decimal  @default(0.00) @db.Decimal(12, 2)
  totalPaidPrincipal   Decimal  @default(0.00) @db.Decimal(12, 2)
  status               String   @default("ACTIVE") // ACTIVE, SETTLED, OVERDUE, AUCTIONED
  lockerBoxNo          String?
  sanctionedAt         DateTime @default(now())
  releasedAt           DateTime?

  pledgedItems         PledgedItem[]

  @@index([tenantId])
  @@index([loanNo])
  @@map("girvi_loans")
}

// 9. Pledged Collateral Articles
model PledgedItem {
  id             String    @id @default(uuid())
  loanId         String
  loan           GirviLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  description    String
  grossWeight    Decimal   @db.Decimal(10, 4)
  lessWeight     Decimal   @db.Decimal(10, 4)
  netWeight      Decimal   @db.Decimal(10, 4)
  purityPercent  Decimal   @db.Decimal(5, 2)
  fineWeight     Decimal   @db.Decimal(10, 4)
  marketValuation Decimal  @db.Decimal(12, 2)
  photoUrl       String?   @db.Text

  @@index([loanId])
  @@map("pledged_items")
}

// 10. Savings Scheme Plans (11+1 Bonus)
model SavingsScheme {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schemeName         String
  schemeType         String   @default("CASH_BONUS_11_PLUS_1") // CASH_BONUS_11_PLUS_1, GOLD_WEIGHT_ACCUMULATION
  monthlyInstallment Decimal  @db.Decimal(12, 2)
  durationMonths     Int      @default(11) // BUDS Act strictly <= 11 months
  bonusAmount        Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  members            SchemeMember[]

  @@index([tenantId])
  @@map("savings_schemes")
}

// 11. Scheme Enrollment & Member Passbooks
model SchemeMember {
  id                 String        @id @default(uuid())
  schemeId           String
  scheme             SavingsScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  passbookNo         String        @unique
  totalDeposited     Decimal       @default(0.00) @db.Decimal(12, 2)
  installmentsPaid   Int           @default(0)
  status             String        @default("ACTIVE") // ACTIVE, MATURED, REDEEMED
  enrolledAt         DateTime      @default(now())

  @@index([schemeId])
  @@index([customerId])
  @@map("scheme_members")
}

// 12. Karigar (Artisan) Workshop Accounts
model KarigarAccount {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  specialization     String
  workshopCity       String
  phone              String
  metalBalanceGrams  Decimal  @default(0.0000) @db.Decimal(10, 4)
  laborBalanceRupees Decimal  @default(0.00) @db.Decimal(12, 2)
  allowedGhatRate    Decimal  @default(2.00) @db.Decimal(5, 2)
  createdAt          DateTime @default(now())

  transactions       KarigarTransaction[]

  @@index([tenantId])
  @@map("karigar_accounts")
}

// 13. Karigar Dual-Entry Ledger Transactions
model KarigarTransaction {
  id                   String         @id @default(uuid())
  karigarId            String
  karigar              KarigarAccount @relation(fields: [karigarId], references: [id], onDelete: Cascade)
  voucherNo            String
  type                 String         // ISSUE, RECEIVE, PAYMENT
  description          String         @db.Text
  purity               String?
  metalIssuedGrams     Decimal?       @db.Decimal(10, 4)
  metalReceivedGrams   Decimal?       @db.Decimal(10, 4)
  wastageGrams         Decimal?       @db.Decimal(10, 4)
  runningMetalBalance  Decimal        @db.Decimal(10, 4)
  labourEarned         Decimal?       @db.Decimal(12, 2)
  labourPaid           Decimal?       @db.Decimal(12, 2)
  runningLabourBalance Decimal        @db.Decimal(12, 2)
  createdAt            DateTime       @default(now())

  @@index([karigarId])
  @@map("karigar_transactions")
}

// 14. Customer Udhaar (Credit) Accounts
model UdhaarAccount {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceNo          String
  totalBillAmount    Decimal  @db.Decimal(12, 2)
  totalPaid          Decimal  @default(0.00) @db.Decimal(12, 2)
  balanceDue         Decimal  @db.Decimal(12, 2)
  daysOutstanding    Int      @default(0)
  creditLimit        Decimal  @db.Decimal(12, 2)
  isBlocked          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@map("udhaar_accounts")
}

// 15. 5-Minute Scraped Bullion Rates History
model BullionRateHistory {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gold24k    Decimal  @db.Decimal(10, 2)
  gold22k    Decimal  @db.Decimal(10, 2)
  gold20k    Decimal  @db.Decimal(10, 2)
  gold18k    Decimal  @db.Decimal(10, 2)
  gold14k    Decimal  @db.Decimal(10, 2)
  silver999  Decimal  @db.Decimal(10, 2)
  silver925  Decimal  @db.Decimal(10, 2)
  source     String   @default("IBJA_BENCHMARK")
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@map("bullion_rate_history")
}
